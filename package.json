                    "build:pages":  "next build \u0026\u0026 node -e \"const fs=require(\u0027fs\u0027);const path=require(\u0027path\u0027);const out=\u0027out\u0027;const docs=\u0027docs\u0027;try{if(fs.existsSync(docs)){fs.rmSync(docs,{recursive:true,force:true});}if(!fs.existsSync(out)){console.error(\u0027Missing out/ directory. Ensure next.config.js has output:\\\u0027export\\\u0027.\u0027);process.exit(1);}fs.renameSync(out,docs);}catch(e){console.error(\u0027Move out-\u003edocs failed:\u0027,e);process.exit(1);}const idx=path.join(docs,\u0027index.html\u0027);if(fs.existsSync(idx)){fs.copyFileSync(idx,path.join(docs,\u0027404.html\u0027));}fs.writeFileSync(path.join(docs,\u0027.nojekyll\u0027),\u0027\u0027);fs.writeFileSync(path.join(docs,\u0027CNAME\u0027),\u0027darcape.com\u0027);\"",
